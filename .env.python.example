# Бот в сообщениях сообщества ВК. Секреты не отправляйте в чат или Git.
VK_BOT_GROUP_ID=242305804
VK_BOT_TOKEN=
# Числовой ID вашего личного профиля ВК — администратор бота.
OWNER_VK_ID=
DATA_DIR=./data
# Без расходов на ИИ; публикация демо-текстов запрещена.
DEMO_MODE=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ключ публикаций администратора. НЕ ключ сообщества бота.
VK_ACCESS_TOKEN=
# Для проекта 1 с несколькими участниками:
# VK_ACCESS_TOKEN_PROJECT_1=
# Необязательный личный ключ публикаций пользователя ВК:
# VK_ACCESS_TOKEN_USER_123456789=

# Необязательно: OAuth-подключение через кнопку. Приложению нужны wall и photos.
VK_OAUTH_CLIENT_ID=54825414
VK_OAUTH_PROVIDER=vkid
# Только для разрешённого приложению authorization code flow vk_api:
VK_OAUTH_CLIENT_SECRET=
# HTTPS-адрес без пути
OAUTH_PUBLIC_URL=https://bot.itiscat.ru
# Локальный порт; наружу открывается HTTPS reverse proxy, не этот порт.
OAUTH_PORT=8081
