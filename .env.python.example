# Бот в сообщениях сообщества ВК. Секреты не отправляйте в чат или Git.
VK_BOT_GROUP_ID=242305804
VK_BOT_TOKEN=
# Числовой ID вашего личного профиля ВК — администратор бота.
OWNER_VK_ID=
DATA_DIR=./data
# Без расходов на ИИ; публикация демо-текстов запрещена.
DEMO_MODE=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ключ публикаций администратора. НЕ ключ сообщества бота.
VK_ACCESS_TOKEN=
# Для проекта 1 с несколькими участниками:
# VK_ACCESS_TOKEN_PROJECT_1=
# Необязательный личный ключ публикаций пользователя ВК:
# VK_ACCESS_TOKEN_USER_123456789=

# Необязательно: OAuth-подключение через кнопку. Приложению нужны wall и photos.
VK_OAUTH_CLIENT_ID=54825715
VK_OAUTH_PROVIDER=vkid
# Для пользовательского Implicit Flow через oauth.vk.com: VK_OAUTH_PROVIDER=vk_implicit
# Только для разрешённого приложению authorization code flow vk_api:
VK_OAUTH_CLIENT_SECRET=
# HTTPS-адрес без пути. Должен совпадать с настройками приложения ВК.
OAUTH_PUBLIC_URL=https://bot.itiscat.ru
# Локальный порт; наружу открывается HTTPS reverse proxy, не этот порт.
OAUTH_PORT=8081

# Интерфейс: vk (по умолчанию) или telegram.
BOT_TRANSPORT=vk
# Telegram: polling (getUpdates через сервис) или webhook.
TELEGRAM_UPDATES_MODE=polling
# Числовой ID администратора Telegram. Не OWNER_VK_ID.
OWNER_TELEGRAM_ID=
# Случайный секрет URL webhook, создаёт scripts/configure-telegram.py.
TELEGRAM_WEBHOOK_SECRET=
# Telegram через chatbot.hopop.ru.
# API-ключ сервиса, НЕ токен BotFather.
CHATBOT_API_KEY=
# UUID именно @PubliKotBot в сервисе, не username и не ID Studio912 из примера.
CHATBOT_BOT_ID=691ae7a7-6786-4d3d-9a35-7a3689263984
# Необязательные ручные ключи публикаций Telegram (отдельно от ID/проектов ВК).
# TELEGRAM_VK_ACCESS_TOKEN=
# TELEGRAM_VK_ACCESS_TOKEN_PROJECT_1=
# TELEGRAM_VK_ACCESS_TOKEN_USER_123456789=
