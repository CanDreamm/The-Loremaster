# Не отправляйте заполненный файл в чат или Git.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# HTTP CONNECT или SOCKS5. Спецсимволы в логине/пароле кодируются как URL.
# Пример формата: http://USER:PASSWORD@HOST:PORT
TELEGRAM_PROXY=
DATA_DIR=./data
# true: без обращения к ИИ, публикация запрещена
DEMO_MODE=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# В первой версии единый ключ должен иметь права на выбранные сообщества.
# Точный тип ключа и права проверяются на реальном аккаунте.
VK_ACCESS_TOKEN=
