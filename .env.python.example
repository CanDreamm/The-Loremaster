# Не отправляйте заполненный файл в чат или Git.
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Это администратор: назначает пользователей и проекты командами бота.
# HTTP CONNECT или SOCKS5. Спецсимволы в логине/пароле кодируются как URL.
# Пример формата: http://USER:PASSWORD@HOST:PORT
TELEGRAM_PROXY=
DATA_DIR=./data
# true: без обращения к ИИ, публикация запрещена
DEMO_MODE=true
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Ключ ниже используется только администратором.
VK_ACCESS_TOKEN=
# Для общего проекта с номером 1 добавьте отдельную переменную:
# VK_ACCESS_TOKEN_PROJECT_1=
# Необязательный личный ключ участника: VK_ACCESS_TOKEN_ЧИСЛОВОЙ_ID=
